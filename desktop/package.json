{
  "name": "@duly/desktop",
  "productName": "Duly",
  "private": true,
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "description": "Duly for the desktop: the same app in its own window, with the engine running on this machine.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --coverage",
    "start": "npm run build && electron .",
    "smoke": "npm run build && electron . --smoke"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-dmg": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@electron-forge/plugin-fuses": "8.0.1",
    "@electron/fuses": "2.1.3",
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^5.0.2",
    "electron": "44.4.5",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  }
}
