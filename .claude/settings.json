{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [{ "type": "command", "command": "cd \"$CLAUDE_PROJECT_DIR\" && uv run --quiet python .claude/hooks/guard_paths.py" }]
      },
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "cd \"$CLAUDE_PROJECT_DIR\" && uv run --quiet python .claude/hooks/guard_bash.py" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [{ "type": "command", "command": "cd \"$CLAUDE_PROJECT_DIR\" && uv run --quiet python .claude/hooks/lint_touched.py" }]
      }
    ]
  }
}
