{
  "name": "duly",
  "private": true,
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "workspaces": [
    "web",
    "ops",
    "desktop"
  ],
  "scripts": {
    "lint": "eslint . && prettier --check \"{web,ops,desktop}/**/*.{ts,tsx,css,html,json}\"",
    "typecheck": "npm run typecheck -w web && npm run typecheck -w ops && npm run typecheck -w desktop",
    "test": "npm run test -w web && npm run test -w ops && npm run test -w desktop",
    "build": "npm run build -w web && npm run build -w ops"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "image-size": "file:tools/npm/image-size-compat",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.9",
    "typescript-eslint": "^8.71.0"
  },
  "allowScripts": {
    "macos-alias@0.2.12": true,
    "fs-xattr@0.3.1": true,
    "fsevents@2.3.3": true
  },
  "overrides": {
    "appdmg": {
      "image-size": "$image-size"
    }
  }
}
