{
  "name": "duly",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "web",
    "ops"
  ],
  "scripts": {
    "lint": "eslint . && prettier --check \"{web,ops}/**/*.{ts,tsx,css,html,json}\"",
    "typecheck": "npm run typecheck -w web && npm run typecheck -w ops",
    "test": "npm run test -w web && npm run test -w ops",
    "build": "npm run build -w web && npm run build -w ops"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.9",
    "typescript-eslint": "^8.71.0"
  }
}
