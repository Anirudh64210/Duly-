{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duly.local/contracts/update.schema.json",
  "title": "Law update",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "headline", "legal_status", "status_as_of", "claims", "categories", "checks", "approval", "history"],
  "properties": {
    "id": { "type": "string" },
    "headline": { "type": "string" },
    "plain": {
      "type": "string",
      "minLength": 1,
      "description": "What the update says, in calm plain words that pass the plain checks. Every number in it appears in a claim's quote."
    },
    "source_label": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agency", "document", "dated"],
      "properties": {
        "agency": { "type": "string", "minLength": 1 },
        "document": { "type": "string", "minLength": 1 },
        "dated": { "type": "string", "format": "date" }
      },
      "description": "The source as the screen names it: the agency, the document, and the document's own date."
    },
    "topic": { "type": "string", "minLength": 1, "description": "A short plain name for what the update is about." },
    "kind": { "enum": ["change", "reminder", "context"] },
    "stages": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9_.]+$" },
      "description": "The pack stage ids the update bears on. Matching reads them."
    },
    "legal_status": {
      "enum": [
        "announced", "proposed", "comment_period", "omb_review", "final",
        "effective", "enjoined", "stayed", "vacated", "appealed", "rescinded"
      ]
    },
    "status_as_of": { "type": "string", "format": "date" },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "quote", "source_url", "source_kind", "snapshot_sha256", "quote_found"],
        "properties": {
          "text": { "type": "string" },
          "quote": { "type": "string" },
          "source_url": { "type": "string", "pattern": "^https://" },
          "source_kind": { "enum": ["primary", "signal"] },
          "snapshot_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "quote_found": { "type": "boolean" },
          "source_type": {
            "enum": ["uscis_notice", "federal_register", "sevp_broadcast", "court_order", "regulation"],
            "description": "What kind of document the source is."
          }
        }
      }
    },
    "categories": { "type": "array", "items": { "enum": ["f1", "h1b", "o1", "eb1a"] } },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["independent_check_passed", "refutation_survived"],
      "properties": {
        "independent_check_passed": { "type": "boolean" },
        "refutation_survived": { "type": "boolean" }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approved", "approved_by", "approved_at"],
      "properties": {
        "approved": { "type": "boolean" },
        "approved_by": { "type": ["string", "null"] },
        "approved_at": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["on", "legal_status", "note", "source_url"],
        "properties": {
          "on": { "type": "string", "format": "date" },
          "legal_status": { "type": "string" },
          "note": { "type": "string" },
          "source_url": { "type": "string", "pattern": "^https://" }
        }
      }
    }
  }
}
