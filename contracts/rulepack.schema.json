{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duly.local/contracts/rulepack.schema.json",
  "title": "Rule pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "category",
    "jurisdiction",
    "version",
    "regimes",
    "parameters"
  ],
  "properties": {
    "category": {
      "enum": [
        "f1",
        "h1b",
        "o1",
        "eb1a",
        "eb2",
        "eb3",
        "perm",
        "aos",
        "h4",
        "f2",
        "j1",
        "l1",
        "tn"
      ]
    },
    "jurisdiction": {
      "const": "us"
    },
    "version": {
      "type": "string",
      "pattern": "^v[0-9]{4}\\.[0-9]{2}(\\.[0-9]+)?$"
    },
    "regimes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "legal_status",
          "operative",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "legal_status": {
            "enum": [
              "announced",
              "proposed",
              "comment_period",
              "omb_review",
              "final",
              "effective",
              "enjoined",
              "stayed",
              "vacated",
              "appealed",
              "rescinded"
            ]
          },
          "operative": {
            "type": "boolean"
          },
          "note": {
            "type": "string"
          },
          "source": {
            "$ref": "#/$defs/source"
          }
        }
      }
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "value",
          "unit",
          "status",
          "effective_from",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_.]+$"
          },
          "value": {
            "type": [
              "number",
              "string",
              "boolean"
            ]
          },
          "unit": {
            "enum": [
              "days",
              "business_days",
              "months",
              "hours_per_week",
              "count",
              "date",
              "flag"
            ]
          },
          "status": {
            "enum": [
              "settled",
              "guidance",
              "litigated",
              "proposed",
              "school"
            ]
          },
          "regime": {
            "type": "string"
          },
          "effective_from": {
            "type": "string",
            "format": "date"
          },
          "effective_to": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "source": {
            "$ref": "#/$defs/source"
          },
          "reviewed_by": {
            "type": "string"
          },
          "reviewed_on": {
            "type": "string",
            "format": "date"
          },
          "note": {
            "type": "string"
          },
          "derivation": {
            "enum": [
              "verbatim",
              "reading"
            ],
            "description": "verbatim: the value is written in the quoted words. reading: Duly derived the value from the quoted words; the note says how."
          }
        }
      }
    },
    "path": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "facts",
        "stages"
      ],
      "description": "The category's path as data. The engine reads it and holds no scenario of its own.",
      "properties": {
        "facts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fact"
          }
        },
        "stages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stage"
          }
        },
        "lists": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/list"
          }
        },
        "counters": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "calculator",
              "rule_ids"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "calculator": {
                "enum": [
                  "days_without_qualifying_period",
                  "days_in_status",
                  "count_of_facts"
                ]
              },
              "inputs": {
                "type": "object"
              },
              "rule_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              }
            }
          },
          "description": "Counts that need more than date arithmetic. Each names one of a short list of calculators in the engine, and the rules it uses"
        }
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "citation",
        "url",
        "checked_on"
      ],
      "properties": {
        "citation": {
          "type": "string",
          "minLength": 3
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "snapshot_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "checked_on": {
          "type": "string",
          "format": "date"
        },
        "quote": {
          "type": "string",
          "minLength": 8,
          "description": "Exact words from the source that support the value."
        },
        "snapshot": {
          "type": "string",
          "pattern": "^sources/[a-z0-9._-]+$",
          "description": "Saved copy of the source, relative to the pack folder."
        }
      }
    },
    "amount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule"
      ],
      "properties": {
        "rule": {
          "type": "string"
        },
        "sign": {
          "enum": [
            1,
            -1
          ],
          "default": 1
        }
      },
      "description": "A rule's value, added or taken away. Its unit (days, business_days, months) comes from the rule. A literal number is never allowed: every amount is a sourced rule."
    },
    "when": {
      "type": "object",
      "additionalProperties": false,
      "description": "A date: a fact the person entered, or the end of a span or the close of a window already computed, moved by rule amounts. Nothing else.",
      "properties": {
        "fact": {
          "type": "string"
        },
        "window_opens": {
          "type": "string"
        },
        "window_closes": {
          "type": "string"
        },
        "month_day_rule": {
          "type": "string",
          "description": "A rule holding MM-DD, placed in the year of the fact named by in_year_of"
        },
        "in_year_of": {
          "type": "string"
        },
        "add": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/amount"
          }
        },
        "earliest_of": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/when"
          },
          "minItems": 2
        },
        "latest_of": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/when"
          },
          "minItems": 2
        }
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "label"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_.]+$"
        },
        "kind": {
          "enum": [
            "date",
            "count",
            "flag",
            "choice",
            "periods"
          ]
        },
        "label": {
          "type": "string",
          "description": "What the person is asked, in plain words"
        },
        "choices": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "happened": {
          "type": "boolean",
          "default": false,
          "description": "A date of something that already took place, such as a filing. It may not be after today."
        },
        "school": {
          "type": "boolean",
          "default": false,
          "description": "The value depends on the person's school."
        }
      }
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "opens",
        "closes",
        "rule_ids"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_.]+$"
        },
        "label": {
          "type": "string"
        },
        "opens": {
          "$ref": "#/$defs/when"
        },
        "closes": {
          "$ref": "#/$defs/when"
        },
        "rule_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "done_when": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Facts that record the step as taken. Once any is entered, the window no longer matters and is not shown as ahead."
        }
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "entered_when",
        "rule_ids"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_.]+$"
        },
        "label": {
          "type": "string"
        },
        "entered_when": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "description": "Facts that, all entered, place the person in this stage"
        },
        "span": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "starts",
            "ends"
          ],
          "properties": {
            "starts": {
              "$ref": "#/$defs/when"
            },
            "ends": {
              "$ref": "#/$defs/when"
            },
            "longest": {
              "$ref": "#/$defs/amount"
            }
          }
        },
        "follows": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Stages this one comes after. The engine checks each for a gap or an overlap the rules do not allow"
        },
        "gap_allowed": {
          "$ref": "#/$defs/amount"
        },
        "windows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/window"
          }
        },
        "next": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Stages that can follow. Their windows are computed from this stage's facts and shown as what comes next"
        },
        "lists": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rule_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "description": "The rules that define the stage itself"
        }
      }
    },
    "list": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "rule_ids"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_.]+$"
        },
        "label": {
          "type": "string"
        },
        "rule_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      }
    }
  }
}
