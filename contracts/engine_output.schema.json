{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duly.local/contracts/engine_output.schema.json",
  "title": "Engine output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "computed",
    "lists",
    "questions",
    "rulepacks",
    "rules",
    "scope",
    "today",
    "upcoming",
    "verdict"
  ],
  "properties": {
    "verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "reasons"
      ],
      "properties": {
        "state": {
          "enum": [
            "no_open_items",
            "needs_you",
            "talk_to_dso",
            "cannot_tell"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documents_count",
        "rules_checked_on"
      ],
      "properties": {
        "documents_count": {
          "type": "integer",
          "minimum": 0
        },
        "rules_checked_on": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        }
      }
    },
    "computed": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "value",
          "unit",
          "inputs",
          "rule_ids",
          "status",
          "reading"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "value": {
            "type": [
              "number",
              "string",
              "null"
            ]
          },
          "unit": {
            "type": "string"
          },
          "inputs": {
            "type": "object"
          },
          "rule_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "status": {
            "enum": [
              "settled",
              "guidance",
              "litigated",
              "proposed",
              "school"
            ],
            "description": "The weakest status among the rules used."
          },
          "alternates": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "regime",
                "legal_status",
                "value"
              ],
              "properties": {
                "regime": {
                  "type": "string"
                },
                "legal_status": {
                  "type": "string"
                },
                "value": {
                  "type": [
                    "number",
                    "string",
                    "null"
                  ]
                }
              }
            }
          },
          "operative": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "regime",
              "legal_status"
            ],
            "properties": {
              "regime": {
                "type": "string"
              },
              "legal_status": {
                "type": "string"
              }
            },
            "description": "Present with alternates. The regime whose value is shown as the item's value, and that regime's legal status from the pack."
          },
          "reading": {
            "type": "boolean",
            "description": "True when any rule this item used is Duly's reading of the source and not the source's own words. The screen marks the item wherever it is shown."
          },
          "record": {
            "type": "string",
            "pattern": "^[a-z]{1,3}[0-9]{1,4}$",
            "description": "The record this belongs to"
          },
          "as_of": {
            "type": "string",
            "format": "date",
            "description": "On a count: the last day the count runs through, when it stops before today because a fact it rests on was last confirmed on that day (specs/step-w/SPEC-W2.md N3). Absent, the count runs through today. The screen shows it as \"as of\" this day and never counts on from it"
          },
          "planning": {
            "type": "boolean",
            "const": true,
            "description": "Present and true when a date here is set from a product setting in contracts/product_settings.yaml, not from a rule. A planning date is Duly's own choice, never shown as law. Absent on every date that rests on rules alone"
          }
        }
      }
    },
    "rulepacks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "category",
          "version"
        ],
        "properties": {
          "category": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        }
      }
    },
    "rules": {
      "type": "object",
      "description": "Every rule named in computed, upcoming, lists, stages, their windows, checklist steps, and watch, keyed by id. A rule named by a stage that is only next is here too.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "value",
          "unit",
          "status",
          "citation",
          "url",
          "checked_on"
        ],
        "properties": {
          "value": {
            "type": [
              "number",
              "string",
              "boolean"
            ]
          },
          "unit": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "citation": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "checked_on": {
            "type": "string"
          },
          "quote": {
            "type": "string"
          },
          "regime": {
            "type": "string"
          },
          "derivation": {
            "enum": [
              "verbatim",
              "reading"
            ]
          },
          "note": {
            "type": "string"
          },
          "plain": {
            "type": "string",
            "description": "The pack's plain words for this rule."
          }
        }
      }
    },
    "questions": {
      "type": "array",
      "description": "What Duly needs the person to confirm. While any is open the verdict is cannot_tell.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "because"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_.]+$"
          },
          "because": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "about": {
            "type": "object",
            "description": "The values of the inputs that raised the question. The screen sends them back with the answer, so that an answer is never carried over to values it was not given for."
          },
          "record": {
            "type": "string",
            "pattern": "^[a-z]{1,3}[0-9]{1,4}$",
            "description": "The record this belongs to"
          }
        }
      }
    },
    "today": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "time_zone"
      ],
      "properties": {
        "date": {
          "type": "string",
          "format": "date"
        },
        "time_zone": {
          "type": "string"
        }
      }
    },
    "upcoming": {
      "type": "array",
      "description": "The dated items that lie ahead of today on the person's path, soonest first. Arithmetic only: a date, its rules, and nothing about what the person can or should do.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "date",
          "rule_ids",
          "status",
          "reading"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "rule_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "status": {
            "enum": [
              "settled",
              "guidance",
              "litigated",
              "proposed",
              "school"
            ]
          },
          "reading": {
            "type": "boolean"
          },
          "alternates": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "regime",
                "legal_status",
                "value"
              ],
              "properties": {
                "regime": {
                  "type": "string"
                },
                "legal_status": {
                  "type": "string"
                },
                "value": {
                  "type": [
                    "number",
                    "string",
                    "null"
                  ]
                }
              }
            }
          },
          "operative": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "regime",
              "legal_status"
            ],
            "properties": {
              "regime": {
                "type": "string"
              },
              "legal_status": {
                "type": "string"
              }
            },
            "description": "Present with alternates. The regime whose value is shown as the item's value, and that regime's legal status from the pack."
          },
          "record": {
            "type": "string",
            "pattern": "^[a-z]{1,3}[0-9]{1,4}$",
            "description": "The record this belongs to"
          },
          "days_away": {
            "type": "integer",
            "description": "Whole calendar days from today to date, in the person's zone. Arithmetic only, with its working in inputs."
          },
          "inputs": {
            "type": "object",
            "description": "The values the date and days_away were computed from, as on computed items"
          },
          "planning": {
            "type": "boolean",
            "const": true,
            "description": "Present and true when a date here is set from a product setting in contracts/product_settings.yaml, not from a rule. A planning date is Duly's own choice, never shown as law. Absent on every date that rests on rules alone"
          }
        }
      }
    },
    "lists": {
      "type": "array",
      "description": "What an official source lists for a step that lies ahead. Each entry names rules whose quotes the screen shows as written.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "rule_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_.]+$"
          },
          "rule_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "record": {
            "type": "string",
            "pattern": "^[a-z]{1,3}[0-9]{1,4}$",
            "description": "The record this belongs to"
          }
        }
      }
    },
    "regimes": {
      "type": "object",
      "description": "Every regime named by an item's operative or alternates, keyed by id: its legal status, its plain words and its source.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "legal_status",
          "operative",
          "citation",
          "url"
        ],
        "properties": {
          "legal_status": {
            "type": "string"
          },
          "operative": {
            "type": "boolean"
          },
          "plain": {
            "type": "string"
          },
          "citation": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "checked_on": {
            "type": "string"
          }
        }
      }
    },
    "answers_read": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_.:]+$"
      },
      "description": "The ids of the questions whose answers the engine read and used for this output. An answer sent for any other id was not read, and the screen never shows it as standing."
    },
    "stages": {
      "type": "array",
      "description": "The person's path, one entry for each stage entered and each stage that may come next. Every id in computed and upcoming is in exactly one stage's items.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "category",
          "label",
          "state",
          "rule_ids",
          "items"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_.]+$",
            "description": "The stage id, or <stage id>.<record id> for a stage entered once for each record"
          },
          "stage": {
            "type": "string",
            "pattern": "^[a-z0-9_.]+$",
            "description": "The pack's stage id, when id carries a record id"
          },
          "record": {
            "type": "string",
            "pattern": "^[a-z]{1,3}[0-9]{1,4}$",
            "description": "The record this belongs to"
          },
          "category": {
            "type": "string",
            "pattern": "^[a-z0-9]+$"
          },
          "label": {
            "type": "string"
          },
          "own_name": {
            "type": [
              "string",
              "null"
            ],
            "description": "The person's own name for what the stage rests on, such as a program's school and field, as entered"
          },
          "state": {
            "enum": [
              "done",
              "current",
              "next",
              "later",
              "unknown"
            ],
            "description": "unknown: the stage's dates are null because a record the engine cannot yet weigh could change them (resolutions point 22); it is never shown as now"
          },
          "starts": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "ends": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "ends_days_away": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Whole days from today to ends, in the person's zone"
          },
          "days_in": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Whole days from starts through today, in the person's zone"
          },
          "days_total": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Whole days from starts through ends"
          },
          "rule_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The ids of the computed and upcoming items that belong to this stage"
          },
          "windows": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "opens",
                "closes",
                "opens_days_away",
                "closes_days_away",
                "rule_ids",
                "status",
                "reading"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9_.]+$"
                },
                "label": {
                  "type": "string"
                },
                "record": {
                  "type": "string",
                  "pattern": "^[a-z]{1,3}[0-9]{1,4}$",
                  "description": "The record this belongs to"
                },
                "opens": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "date"
                },
                "closes": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "date"
                },
                "opens_days_away": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "description": "Whole days from today to opens, in the person's zone; zero or less once it has opened. Screens read opened from this, never by comparing dates"
                },
                "closes_days_away": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "description": "Whole days from today to closes, in the person's zone; negative once it has closed"
                },
                "rule_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1
                },
                "status": {
                  "enum": [
                    "settled",
                    "guidance",
                    "litigated",
                    "proposed",
                    "school"
                  ]
                },
                "reading": {
                  "type": "boolean"
                },
                "alternates": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "regime",
                      "legal_status",
                      "value"
                    ],
                    "properties": {
                      "regime": {
                        "type": "string"
                      },
                      "legal_status": {
                        "type": "string"
                      },
                      "value": {
                        "type": [
                          "number",
                          "string",
                          "null"
                        ]
                      }
                    }
                  }
                },
                "operative": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "regime",
                    "legal_status"
                  ],
                  "properties": {
                    "regime": {
                      "type": "string"
                    },
                    "legal_status": {
                      "type": "string"
                    }
                  },
                  "description": "Present with alternates. The regime whose value is shown as the item's value, and that regime's legal status from the pack."
                },
                "inputs": {
                  "type": "object",
                  "description": "The values the dates were computed from"
                },
                "planning": {
                  "type": "boolean",
                  "const": true,
                  "description": "Present and true when a date here is set from a product setting in contracts/product_settings.yaml, not from a rule. A planning date is Duly's own choice, never shown as law. Absent on every date that rests on rules alone"
                }
              },
              "description": "A window kept from before it opens until the day after it closes, so that its opening date stays while it is open"
            }
          },
          "lists": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The ids of entries in lists shown for this stage"
          },
          "checklist": {
            "type": [
              "string",
              "null"
            ],
            "description": "The id of this stage's entry in checklists"
          },
          "facts": {
            "type": "object",
            "description": "The fact ids, or <record id>.<field> paths, entered for this stage, with their values as entered"
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The verdict reasons that rest on this stage's items or facts"
          }
        }
      }
    },
    "checklists": {
      "type": "array",
      "description": "The steps an official source lists for a stage, with the person's own confirmations. Confirmations read here are listed in answers_read.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "reading",
          "confirmed",
          "total",
          "steps"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_.]+$",
            "description": "The pack's checklist id, or <checklist id>.<record id> for a stage entered once for each record"
          },
          "stage": {
            "type": "string",
            "pattern": "^[a-z0-9_.]+$",
            "description": "The id of the stage entry it belongs to"
          },
          "record": {
            "type": "string",
            "pattern": "^[a-z]{1,3}[0-9]{1,4}$",
            "description": "The record this belongs to"
          },
          "label": {
            "type": "string"
          },
          "reading": {
            "type": "boolean",
            "description": "True when the list is Duly's assembly of several rules"
          },
          "confirmed": {
            "type": "integer",
            "minimum": 0
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "label",
                "rule_ids",
                "who",
                "confirmed_on"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9_]+$"
                },
                "label": {
                  "type": "string"
                },
                "rule_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1
                },
                "who": {
                  "enum": [
                    "student",
                    "employer",
                    "school"
                  ]
                },
                "school": {
                  "type": "boolean"
                },
                "confirmed_on": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "date",
                  "description": "The day of the person's confirmation step.<checklist>.<step>, or null"
                }
              }
            }
          }
        }
      }
    },
    "checkins": {
      "type": "array",
      "description": "Records whose facts the person confirms again at an interval set by a product setting (checkin.job_days, checkin.petition_days), not by a rule. One entry per record that has one. Dates come from the engine; the screen never counts them",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "record",
          "kind",
          "confirmed_on",
          "due",
          "due_days_away",
          "question"
        ],
        "properties": {
          "record": {
            "type": "string",
            "pattern": "^[a-z]{1,3}[0-9]{1,4}$",
            "description": "The record this belongs to"
          },
          "kind": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,31}$",
            "description": "The record's kind, as in the case, such as work or petition"
          },
          "confirmed_on": {
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "description": "The last day the person confirmed this record's facts, or null when never confirmed"
          },
          "due": {
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "description": "The day the next check-in is due: confirmed_on plus the product setting's days. Null when confirmed_on is null"
          },
          "due_days_away": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Whole days from today to due, in the person's zone; zero or less once it is due"
          },
          "question": {
            "type": "string",
            "pattern": "^[a-z0-9_.]+$",
            "description": "The id of the question that confirms this record's facts again. It is listed in questions while the check-in is due"
          }
        }
      }
    },
    "watch": {
      "type": "array",
      "description": "The dates on the person's documents and records that the pack names to watch, such as a card's or a passport's last day, soonest first. Arithmetic only: a date, its rules, and nothing about what the person can or should do",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "date",
          "days_away",
          "close",
          "record",
          "rule_ids",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_.]+$"
          },
          "label": {
            "type": "string",
            "description": "The pack's label for the date, such as EAD card"
          },
          "date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "description": "The date as entered in the record, or null when the record does not give it"
          },
          "days_away": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Whole calendar days from today to date, in the person's zone; negative once it has passed. Null when date is null"
          },
          "close": {
            "type": "boolean",
            "description": "True when days_away is at most the product setting watch.close_days. A product setting, not a rule; false when date is null"
          },
          "record": {
            "type": "string",
            "pattern": "^[a-z]{1,3}[0-9]{1,4}$",
            "description": "The record this belongs to"
          },
          "rule_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "status": {
            "enum": [
              "settled",
              "guidance",
              "litigated",
              "proposed",
              "school"
            ],
            "description": "The weakest status among the rules used."
          }
        }
      }
    }
  }
}
