{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duly.local/contracts/engine_output.schema.json",
  "title": "Engine output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "computed",
    "lists",
    "questions",
    "rulepacks",
    "rules",
    "scope",
    "today",
    "upcoming",
    "verdict"
  ],
  "properties": {
    "verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "reasons"
      ],
      "properties": {
        "state": {
          "enum": [
            "no_open_items",
            "needs_you",
            "talk_to_dso",
            "cannot_tell"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documents_count",
        "rules_checked_on"
      ],
      "properties": {
        "documents_count": {
          "type": "integer",
          "minimum": 0
        },
        "rules_checked_on": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        }
      }
    },
    "computed": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "value",
          "unit",
          "inputs",
          "rule_ids",
          "status",
          "reading"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "value": {
            "type": [
              "number",
              "string",
              "null"
            ]
          },
          "unit": {
            "type": "string"
          },
          "inputs": {
            "type": "object"
          },
          "rule_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "status": {
            "enum": [
              "settled",
              "guidance",
              "litigated",
              "proposed",
              "school"
            ],
            "description": "The weakest status among the rules used."
          },
          "alternates": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "regime",
                "legal_status",
                "value"
              ],
              "properties": {
                "regime": {
                  "type": "string"
                },
                "legal_status": {
                  "type": "string"
                },
                "value": {
                  "type": [
                    "number",
                    "string",
                    "null"
                  ]
                }
              }
            }
          },
          "operative": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "regime",
              "legal_status"
            ],
            "properties": {
              "regime": {
                "type": "string"
              },
              "legal_status": {
                "type": "string"
              }
            },
            "description": "Present with alternates. The regime whose value is shown as the item's value, and that regime's legal status from the pack."
          },
          "reading": {
            "type": "boolean",
            "description": "True when any rule this item used is Duly's reading of the source and not the source's own words. The screen marks the item wherever it is shown."
          }
        }
      }
    },
    "rulepacks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "category",
          "version"
        ],
        "properties": {
          "category": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        }
      }
    },
    "rules": {
      "type": "object",
      "description": "Every rule named in computed, keyed by id.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "value",
          "unit",
          "status",
          "citation",
          "url",
          "checked_on"
        ],
        "properties": {
          "value": {
            "type": [
              "number",
              "string",
              "boolean"
            ]
          },
          "unit": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "citation": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "checked_on": {
            "type": "string"
          },
          "quote": {
            "type": "string"
          },
          "regime": {
            "type": "string"
          },
          "derivation": {
            "enum": [
              "verbatim",
              "reading"
            ]
          },
          "note": {
            "type": "string"
          },
          "plain": {
            "type": "string",
            "description": "The pack's plain words for this rule."
          }
        }
      }
    },
    "questions": {
      "type": "array",
      "description": "What Duly needs the person to confirm. While any is open the verdict is cannot_tell.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "because"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_.]+$"
          },
          "because": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "about": {
            "type": "object",
            "description": "The values of the inputs that raised the question. The screen sends them back with the answer, so that an answer is never carried over to values it was not given for."
          }
        }
      }
    },
    "today": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "time_zone"
      ],
      "properties": {
        "date": {
          "type": "string",
          "format": "date"
        },
        "time_zone": {
          "type": "string"
        }
      }
    },
    "upcoming": {
      "type": "array",
      "description": "The dated items that lie ahead of today on the person's path, soonest first. Arithmetic only: a date, its rules, and nothing about what the person can or should do.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "date",
          "rule_ids",
          "status",
          "reading"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "rule_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "status": {
            "enum": [
              "settled",
              "guidance",
              "litigated",
              "proposed",
              "school"
            ]
          },
          "reading": {
            "type": "boolean"
          },
          "alternates": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "regime",
                "legal_status",
                "value"
              ],
              "properties": {
                "regime": {
                  "type": "string"
                },
                "legal_status": {
                  "type": "string"
                },
                "value": {
                  "type": [
                    "number",
                    "string",
                    "null"
                  ]
                }
              }
            }
          },
          "operative": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "regime",
              "legal_status"
            ],
            "properties": {
              "regime": {
                "type": "string"
              },
              "legal_status": {
                "type": "string"
              }
            },
            "description": "Present with alternates. The regime whose value is shown as the item's value, and that regime's legal status from the pack."
          }
        }
      }
    },
    "lists": {
      "type": "array",
      "description": "What an official source lists for a step that lies ahead. Each entry names rules whose quotes the screen shows as written.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "rule_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_.]+$"
          },
          "rule_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          }
        }
      }
    },
    "regimes": {
      "type": "object",
      "description": "Every regime named by an item's operative or alternates, keyed by id: its legal status, its plain words and its source.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "legal_status",
          "operative",
          "citation",
          "url"
        ],
        "properties": {
          "legal_status": {
            "type": "string"
          },
          "operative": {
            "type": "boolean"
          },
          "plain": {
            "type": "string"
          },
          "citation": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "checked_on": {
            "type": "string"
          }
        }
      }
    },
    "answers_read": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_.:]+$"
      },
      "description": "The ids of the questions whose answers the engine read and used for this output. An answer sent for any other id was not read, and the screen never shows it as standing."
    }
  }
}
