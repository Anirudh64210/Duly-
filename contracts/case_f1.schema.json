{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duly.local/contracts/case_f1.schema.json",
  "title": "F-1 case, as entered by the user",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "program_end_date",
    "degree_level",
    "documents_count",
    "employment",
    "time_zone"
  ],
  "properties": {
    "program_end_date": {
      "type": "string",
      "format": "date",
      "pattern": "^(19[5-9][0-9]|20[0-9]{2})-[0-9]{2}-[0-9]{2}$"
    },
    "degree_level": {
      "enum": [
        "bachelor",
        "master",
        "doctorate"
      ]
    },
    "documents_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "cpt_full_time_days": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 5000,
      "description": "Full-time CPT days as the person entered them. Absent or null means nothing was entered. It is never taken as zero."
    },
    "opt": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "dso_recommendation_date",
        "i765_filed_date",
        "ead_start",
        "ead_end"
      ],
      "properties": {
        "dso_recommendation_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date",
          "pattern": "^(19[5-9][0-9]|20[0-9]{2})-[0-9]{2}-[0-9]{2}$"
        },
        "i765_filed_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date",
          "pattern": "^(19[5-9][0-9]|20[0-9]{2})-[0-9]{2}-[0-9]{2}$"
        },
        "ead_start": {
          "type": [
            "string",
            "null"
          ],
          "format": "date",
          "pattern": "^(19[5-9][0-9]|20[0-9]{2})-[0-9]{2}-[0-9]{2}$"
        },
        "ead_end": {
          "type": [
            "string",
            "null"
          ],
          "format": "date",
          "pattern": "^(19[5-9][0-9]|20[0-9]{2})-[0-9]{2}-[0-9]{2}$"
        }
      }
    },
    "stem": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "dso_recommendation_date",
        "i765_filed_date",
        "ead_start",
        "ead_end"
      ],
      "properties": {
        "dso_recommendation_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date",
          "pattern": "^(19[5-9][0-9]|20[0-9]{2})-[0-9]{2}-[0-9]{2}$"
        },
        "i765_filed_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date",
          "pattern": "^(19[5-9][0-9]|20[0-9]{2})-[0-9]{2}-[0-9]{2}$"
        },
        "ead_start": {
          "type": [
            "string",
            "null"
          ],
          "format": "date",
          "pattern": "^(19[5-9][0-9]|20[0-9]{2})-[0-9]{2}-[0-9]{2}$"
        },
        "ead_end": {
          "type": [
            "string",
            "null"
          ],
          "format": "date",
          "pattern": "^(19[5-9][0-9]|20[0-9]{2})-[0-9]{2}-[0-9]{2}$"
        }
      }
    },
    "employment": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "start",
          "end",
          "hours_per_week",
          "employer_reported"
        ],
        "properties": {
          "start": {
            "type": "string",
            "format": "date",
            "pattern": "^(19[5-9][0-9]|20[0-9]{2})-[0-9]{2}-[0-9]{2}$"
          },
          "end": {
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "pattern": "^(19[5-9][0-9]|20[0-9]{2})-[0-9]{2}-[0-9]{2}$"
          },
          "hours_per_week": {
            "type": "number",
            "minimum": 0,
            "maximum": 168
          },
          "employer_reported": {
            "type": "boolean"
          }
        }
      },
      "maxItems": 50
    },
    "cap_gap": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "petition_filed_on",
        "requested_start",
        "change_of_status",
        "status"
      ],
      "properties": {
        "petition_filed_on": {
          "type": "string",
          "format": "date",
          "pattern": "^(19[5-9][0-9]|20[0-9]{2})-[0-9]{2}-[0-9]{2}$"
        },
        "requested_start": {
          "type": "string",
          "format": "date",
          "pattern": "^(19[5-9][0-9]|20[0-9]{2})-[0-9]{2}-[0-9]{2}$"
        },
        "change_of_status": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "pending",
            "approved",
            "denied",
            "rejected",
            "withdrawn",
            "revoked"
          ]
        }
      }
    },
    "time_zone": {
      "type": "string",
      "pattern": "^[A-Za-z]+(/[A-Za-z0-9_+-]+){1,2}$|^UTC$",
      "maxLength": 64,
      "description": "The person's own time zone, as an IANA name such as America/Los_Angeles. Today is the calendar day in this zone."
    },
    "confirmations": {
      "type": "object",
      "maxProperties": 256,
      "description": "The person's answers, one for each question the output raised. Bounded to hold every question a case within this contract can raise: up to four for each of the 50 employment periods, the STEM reports whose dates have passed, the conflicts and the general questions.",
      "propertyNames": {
        "pattern": "^[a-z0-9_.:]+$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "answer",
          "on"
        ],
        "properties": {
          "answer": {
            "type": "boolean"
          },
          "on": {
            "type": "string",
            "format": "date",
            "pattern": "^(19[5-9][0-9]|20[0-9]{2})-[0-9]{2}-[0-9]{2}$"
          },
          "about": {
            "type": "object",
            "description": "The input values the answer was given for, as the question carried them."
          }
        }
      },
      "description": "The person's own answers to questions Duly asked, each with the day it was given."
    }
  },
  "description": "Dates run from 1950 through 2099. Numbers must be finite; NaN and Infinity are refused before validation."
}
